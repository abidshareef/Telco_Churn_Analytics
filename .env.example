# ============================================================================
# SKYBRISK TELCO CHURN ANALYTICS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and adjust values as needed. Never commit `.env`.
# ============================================================================

# Application & Logging
CHURN_APP_ENV=production
CHURN_LOG_LEVEL=INFO
CHURN_LOG_JSON=false

# Paths (relative to repository root or absolute)
CHURN_CONFIG_PATH=configs/default_config.json
CHURN_RAW_DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
CHURN_INTERIM_DIR=data/interim
CHURN_PROCESSED_DIR=data/processed
CHURN_MODEL_ARTIFACT_PATH=models_store/churn_ensemble_model.pkl
CHURN_REPORTS_DIR=reports

# Reproducibility & Training
CHURN_RANDOM_SEED=42
CHURN_TEST_SIZE=0.20
CHURN_CV_FOLDS=5

# REST API Server Configuration
CHURN_API_HOST=0.0.0.0
CHURN_API_PORT=8080
